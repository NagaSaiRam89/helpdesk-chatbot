# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# ── Optional ──────────────────────────────────────────────────────────────────
# Database (omit to use local SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dpm101

# Application
APP_ENV=development
PORT=8000

# CORS (comma-separated origins; use * for development)
CORS_ORIGINS=*

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Gemini concurrency (max simultaneous Gemini requests)
MAX_CONCURRENT_GEMINI=5

# Gemini timeout in seconds
GEMINI_TIMEOUT_SECONDS=30

# Gemini retry settings
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY=1.0

# Retrieval settings
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.05
# Fraction of contentful question terms that must exist in the course docs
# before a question is considered answerable (out-of-scope guard)
RETRIEVAL_MIN_TERM_COVERAGE=0.3
# Minimum best BM25 score the question alone must reach before retrieval
# falls back to a context-expanded query (anaphoric follow-ups like
# "What happens if I miss it?" have no lexical anchor of their own)
RETRIEVAL_ANCHOR_MIN_SCORE=1.0

# Conversation settings
MAX_CONVERSATION_TURNS=10
MAX_MESSAGE_LENGTH=2000

# Rate limiting (sliding window)
RATE_LIMIT_REQUESTS=60          # per session_id
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_IP_REQUESTS=300      # per client IP (higher for shared campus NATs)

